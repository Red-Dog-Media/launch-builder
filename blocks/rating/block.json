{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "launch/rating",
	"title": "Rating Widget",
	"category": "launch-builder",
	"icon": "star-filled",
	"description": "Star rating with review count and platform logos, from Business Info or typed in. Pick a layout from the toolbar (Badge, Card, Pill, Stars) and a look from Styles.",
	"keywords": [
		"reviews",
		"stars",
		"reputation",
		"testimonial",
		"trust"
	],
	"textdomain": "launch-builder",
	"attributes": {
		"type": {
			"type": "string",
			"default": "badge"
		},
		"useGlobal": {
			"type": "boolean",
			"default": false
		},
		"source": {
			"type": "string",
			"default": ""
		},
		"rating": {
			"type": "number",
			"default": 4.8
		},
		"text": {
			"type": "string",
			"default": "887+ Combined Reviews"
		},
		"link": {
			"type": "string",
			"default": ""
		},
		"platforms": {
			"type": "array",
			"default": [],
			"items": {
				"type": "string"
			}
		},
		"size": {
			"type": "string",
			"default": ""
		},
		"contentAlign": {
			"type": "string",
			"default": "start"
		},
		"logos": {
			"type": "array",
			"default": []
		},
		"showRating": {
			"type": "boolean",
			"default": true
		},
		"newTab": {
			"type": "boolean",
			"default": true
		},
		"starCount": {
			"type": "number",
			"default": 5
		},
		"starStyle": {
			"type": "string",
			"default": "sharp"
		},
		"starColor": {
			"type": "string",
			"default": ""
		},
		"starEmpty": {
			"type": "string",
			"default": ""
		},
		"starSize": {
			"type": "number",
			"default": 34
		},
		"starGap": {
			"type": "number",
			"default": 4
		},
		"ratingSize": {
			"type": "number",
			"default": 44
		},
		"ratingColor": {
			"type": "string",
			"default": ""
		},
		"ratingWeight": {
			"type": "string",
			"default": "300"
		},
		"textSize": {
			"type": "number",
			"default": 17
		},
		"textColor": {
			"type": "string",
			"default": ""
		},
		"textWeight": {
			"type": "string",
			"default": "400"
		},
		"logoHeight": {
			"type": "number",
			"default": 46
		},
		"logoGap": {
			"type": "number",
			"default": 12
		},
		"logoPosition": {
			"type": "string",
			"default": "start"
		},
		"logoStyle": {
			"type": "string",
			"default": "original"
		},
		"logoDivider": {
			"type": "boolean",
			"default": false
		},
		"gap": {
			"type": "number",
			"default": 22
		},
		"maxWidth": {
			"type": "number",
			"default": 0
		},
		"mobile": {
			"type": "string",
			"default": "stack"
		},
		"breakpoint": {
			"type": "string",
			"default": "480"
		},
		"mobileScale": {
			"type": "number",
			"default": 85
		},
		"shape": {
			"type": "string",
			"default": "soft"
		},
		"density": {
			"type": "string",
			"default": "default"
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"background": true,
			"gradients": true,
			"text": false
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontFamily": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": true
	},
	"variations": [
		{
			"name": "badge",
			"title": "Rating Badge",
			"description": "Logos, big score, stars and review count in a row.",
			"attributes": {
				"type": "badge",
				"useGlobal": true,
				"size": "md"
			},
			"isActive": [
				"type"
			],
			"scope": [
				"inserter",
				"block",
				"transform"
			],
			"isDefault": true
		},
		{
			"name": "card",
			"title": "Rating Card",
			"description": "Centered card: logos on top, score, stars, caption.",
			"attributes": {
				"type": "card",
				"useGlobal": true,
				"size": "lg",
				"contentAlign": "center"
			},
			"isActive": [
				"type"
			],
			"scope": [
				"inserter",
				"block",
				"transform"
			]
		},
		{
			"name": "pill",
			"title": "Rating Pill",
			"description": "Compact rating row for heroes: round review-site logos, score and stars, review count below.",
			"attributes": {
				"type": "pill",
				"useGlobal": true,
				"size": "md"
			},
			"isActive": [
				"type"
			],
			"scope": [
				"inserter",
				"block",
				"transform"
			]
		},
		{
			"name": "stars",
			"title": "Rating Stars",
			"description": "Stars only (e.g. under a testimonial).",
			"attributes": {
				"type": "stars",
				"useGlobal": true,
				"size": "md"
			},
			"isActive": [
				"type"
			],
			"scope": [
				"inserter",
				"block",
				"transform"
			]
		}
	],
	"render": "file:./render.php",
	"editorScript": "file:./edit.js",
	"style": [
		"file:./style.css",
		"file:./legacy.css"
	],
	"styles": [
		{
			"name": "plain",
			"label": "Plain",
			"isDefault": true
		},
		{
			"name": "soft",
			"label": "Soft"
		},
		{
			"name": "outline",
			"label": "Outline"
		},
		{
			"name": "dark",
			"label": "Dark"
		},
		{
			"name": "brand",
			"label": "Brand"
		}
	],
	"example": {
		"attributes": {
			"type": "badge",
			"size": "md",
			"useGlobal": true,
			"platforms": [
				"google",
				"yelp",
				"bbb"
			]
		}
	}
}
