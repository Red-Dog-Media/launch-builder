{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "launch/entries",
	"title": "Services / Areas List",
	"category": "launch-builder",
	"icon": "list-view",
	"description": "A live list of your Services or Service Areas. Add or remove an entry and every list updates.",
	"keywords": ["services", "service areas", "cities", "list", "dynamic", "query", "menu", "footer"],
	"textdomain": "launch-builder",
	"attributes": {
		"type": { "type": "string", "default": "service" },
		"layout": { "type": "string", "default": "cards" },
		"category": { "type": "string", "default": "" },
		"parent": { "type": "string", "default": "" },
		"limit": { "type": "number", "default": 12 },
		"columns": { "type": "number", "default": 3 },
		"showSummary": { "type": "boolean", "default": true },
		"linkLabel": { "type": "string", "default": "" },
		"excludeCurrent": { "type": "boolean", "default": false },
		"related": { "type": "boolean", "default": false },
		"orderby": { "type": "string", "default": "" },
		"template": { "type": "string", "default": "" },
		"variant": { "type": "string", "default": "" },
		"showIcon": { "type": "boolean", "default": false },
		"inArea": { "type": "string", "default": "" },
		"ids": { "type": ["string", "array"], "default": "" }
	},
	"usesContext": ["postId", "postType"],
	"supports": { "html": false, "align": ["wide", "full"], "spacing": { "margin": true } },
	"render": "file:./render.php",
	"editorScript": "file:./edit.js",
	"style": "file:./style.css"
}
