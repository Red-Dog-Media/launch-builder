{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "launch/breadcrumbs",
	"title": "Breadcrumbs",
	"category": "launch-builder",
	"icon": "arrow-right-alt2",
	"description": "Home > parent > current page, by page role: services (hub > category), service areas (hub > parent area), category pages, posts, archives. Hidden where the chrome map has no crumbs (home, conversion and thank-you pages).",
	"keywords": ["breadcrumb", "trail", "navigation", "path"],
	"textdomain": "launch-builder",
	"usesContext": ["postId", "postType"],
	"attributes": {
		"variant": { "type": "string", "enum": ["contained", "plain", "bar", "pill", "underline"], "default": "contained" },
		"separator": { "type": "string", "enum": ["raquo", "chevron", "slash", "arrow", "dot", "pipe"], "default": "raquo" },
		"homeLabel": { "type": "string", "default": "Home" },
		"showCurrent": { "type": "boolean", "default": true }
	},
	"supports": { "html": false, "align": ["wide", "full"], "spacing": { "margin": true, "padding": true } },
	"render": "file:./render.php",
	"editorScript": "file:./edit.js",
	"style": "file:./style.css"
}
